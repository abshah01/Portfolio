rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    match /meta/visits {
      allow read: if true;
      allow create: if request.resource.data.count == 1;
      allow update: if request.resource.data.count == resource.data.count + 1;
    }
    match /{col}/{id} {
      allow read: if col in ['scores', 'snake'];
      allow create: if col in ['scores', 'snake']
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 5000;
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300;
    }
  }
}
